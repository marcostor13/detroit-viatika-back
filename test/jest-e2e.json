{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "globalSetup": "<rootDir>/setup/mongo-memory-env.js",
  "globalTeardown": "<rootDir>/setup/mongo-memory-teardown.js",
  "testTimeout": 30000,
  "maxWorkers": 1
}
