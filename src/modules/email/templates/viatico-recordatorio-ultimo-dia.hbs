{{> email-header}}

      <h1 class="heading">Hoy vence tu periodo de viáticos</h1>
      <p>Estimado/a <strong>{{collaboratorName}}</strong>,</p>
      <div class="urgent-box">
        <p style="margin: 0;"><strong>Hoy, {{endDate}},</strong> es el último día de tu periodo de viáticos. Asegúrate de cargar todos tus comprobantes antes de que finalice el día.</p>
      </div>
      <p class="label">Datos del viaje:</p>
      <ul class="quick-list">
        <li>Lugar: {{place}}</li>
        <li>Fecha de vencimiento: {{endDate}}</li>
      </ul>
      <div class="btn-container">
        <a href="{{platformUrl}}" class="btn">Cargar comprobantes ahora</a>
      </div>
{{> email-footer}}
