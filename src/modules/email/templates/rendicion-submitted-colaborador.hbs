{{> email-header}}
      <span class="badge badge-info">Pendiente de aprobación</span>
      <h1 class="title">Rendición enviada</h1>
      <p>Estimado/a <strong>{{collaboratorName}}</strong>,</p>
      <p>Usted ha enviado una rendición de gastos que se encuentra <strong>pendiente de aprobación</strong>. Le notificaremos por este medio cuando exista una respuesta.</p>

      <p class="label">Detalles rápidos:</p>
      <div class="box">
        <div class="row"><strong>Rendición:</strong> {{reportTitle}}</div>
        {{#if hasDirectaDeposit}}
          <div class="row"><strong>Total depositado:</strong> {{currencySymbol}} {{depositFormatted}}</div>
          <div class="row"><strong>Total gastado:</strong> {{currencySymbol}} {{expenseTotalFormatted}}</div>
          <div class="row"><strong>Saldo disponible:</strong> {{currencySymbol}} {{saldoFormatted}}</div>
        {{else}}
          <div class="row"><strong>Presupuesto:</strong> {{currencySymbol}} {{budgetFormatted}}</div>
        {{/if}}
        <div class="row"><strong>Documentos adjuntos:</strong> {{expenseCount}}</div>
      </div>

      <div class="btn-container">
        <a href="{{platformUrl}}" class="btn">Ir a la plataforma</a>
      </div>
{{> email-footer}}
