{{> email-header}}
      <h1 class="title">Rendición enviada</h1>
      <p>Estimado/a <strong>{{collaboratorName}}</strong>,</p>
      <p>Usted ha enviado una rendición de gastos que se encuentra <strong>pendiente de aprobación</strong>. Le notificaremos por este medio cuando exista una respuesta.</p>

      <div class="box">
        <div class="row"><strong>Título:</strong> {{reportTitle}}</div>
        {{#if hasDirectaDeposit}}
          <div class="row"><strong>Total depositado:</strong> S/ {{depositFormatted}}</div>
          <div class="row"><strong>Total gastado:</strong> S/ {{expenseTotalFormatted}}</div>
          <div class="row"><strong>Saldo disponible:</strong> S/ {{saldoFormatted}}</div>
        {{else}}
          <div class="row"><strong>Presupuesto:</strong> S/ {{budgetFormatted}}</div>
        {{/if}}
        <div class="row"><strong>Documentos adjuntos:</strong> {{expenseCount}}</div>
      </div>

      <div class="btn-container">
        <a href="{{platformUrl}}" class="btn">Ir a la plataforma</a>
      </div>
{{> email-footer}}
