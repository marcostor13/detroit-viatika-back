{{> email-header}}
      <span class="badge badge-danger">Rendición cancelada</span>
      <h1 class="title">Rendición cancelada</h1>
      <p>Estimado/a <strong>{{adminName}}</strong>,</p>
      <p>El colaborador <strong>{{collaboratorName}}</strong> ha <strong>cancelado</strong> su solicitud de rendición.</p>

      <p class="label">Detalles rápidos:</p>
      <div class="box">
        <div class="row"><strong>Rendición:</strong> {{reportTitle}}</div>
        <div class="row"><strong>Colaborador:</strong> {{collaboratorName}}</div>
        {{#if cancelReason}}<div class="row"><strong>Motivo:</strong> {{cancelReason}}</div>{{/if}}
      </div>

      <p>No se requiere ninguna acción de su parte.</p>

      <div class="btn-container">
        <a href="{{platformUrl}}" class="btn">Ir a la plataforma</a>
      </div>
{{> email-footer}}
