{{> email-header}}

      <h1 class="heading">Nueva solicitud de viáticos</h1>
      <p>Estimado/a <strong>{{recipientName}}</strong>,</p>
      <p>El colaborador <strong>{{collaboratorName}}</strong> ha enviado una nueva solicitud de viáticos pendiente de aprobacion.</p>
      <p class="label">Detalles:</p>
      <ul class="quick-list">
        <li>Centro de costo: {{projectLabel}}</li>
        <li>Lugar: {{place}}</li>
        <li>Fechas: {{startDate}} al {{endDate}}</li>
        <li>Monto total: {{currencySymbol}} {{totalFormatted}}</li>
      </ul>
      <div class="btn-container">
        <a href="{{platformUrl}}" class="btn">Ir a la plataforma</a>
      </div>
{{> email-footer}}
