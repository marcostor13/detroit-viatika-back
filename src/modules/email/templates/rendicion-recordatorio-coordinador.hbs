{{> email-header}}
      <span class="badge badge-info">Recordatorio</span>
      <h1 class="title">Rendiciones pendientes de revisión</h1>
      <p>Estimado/a <strong>{{coordinatorName}}</strong>,</p>
      <p>Tiene <strong>{{pendingCount}} rendición(es)</strong> esperando su revisión y aprobación. Revíselas a la brevedad para no retrasar el proceso de pago de sus colaboradores.</p>

      <p class="label">Detalles rápidos:</p>
      <div class="box">
        <div class="row"><strong>Rendiciones pendientes:</strong> {{pendingCount}}</div>
      </div>

      <p class="label">Rendiciones por revisar:</p>
      <table class="data">
        <tr>
          <th>Colaborador</th>
          <th>Rendición</th>
          <th>Vence</th>
        </tr>
        {{#each reports}}
        <tr>
          <td>{{this.collaboratorName}}</td>
          <td>{{this.title}}</td>
          <td>{{#if this.endDateFormatted}}{{this.endDateFormatted}}{{else}}—{{/if}}</td>
        </tr>
        {{/each}}
      </table>

      <div class="btn-container">
        <a href="{{platformUrl}}" class="btn">Ir a la plataforma</a>
      </div>
{{> email-footer}}
