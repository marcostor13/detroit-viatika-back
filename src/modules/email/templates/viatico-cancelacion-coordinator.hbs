{{> email-header}}

      <span class="badge">Solicitud cancelada</span>
      <h1 class="heading">Solicitud de viáticos cancelada</h1>
      <p>Estimado/a <strong>{{coordinatorName}}</strong>,</p>
      <p>El colaborador <strong>{{collaboratorName}}</strong> ha cancelado su solicitud de viáticos que estaba pendiente de aprobación.</p>
      <div class="details">{{plainSummary}}</div>
      {{#if cancelReason}}
      <p><strong>Motivo de cancelación:</strong></p>
      <div class="reason">{{cancelReason}}</div>
      {{/if}}
      <div class="btn-container">
        <a href="{{platformUrl}}" class="btn">Ir a la plataforma</a>
      </div>
{{> email-footer}}
