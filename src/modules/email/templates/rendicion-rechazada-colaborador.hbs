{{> email-header}}
      <span class="badge badge-danger">Rendición rechazada</span>
      <h1 class="title">Rendición rechazada</h1>
      <p>Estimado/a <strong>{{collaboratorName}}</strong>,</p>
      <p>Su rendición fue <strong>rechazada por {{rejectedBy}}</strong>. Por favor revise el detalle y realice los ajustes correspondientes.</p>

      <p class="label">Detalles rápidos:</p>
      <div class="box">
        <div class="row"><strong>Rendición:</strong> {{reportTitle}}</div>
        <div class="row"><strong>Colaborador:</strong> {{collaboratorName}}</div>
        <div class="row"><strong>Motivo:</strong> {{rejectionReason}}</div>
      </div>

      <div class="btn-container">
        <a href="{{platformUrl}}" class="btn">Ir a la plataforma</a>
      </div>
{{> email-footer}}
