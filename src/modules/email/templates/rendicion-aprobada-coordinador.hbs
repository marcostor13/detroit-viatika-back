{{> email-header}}
      <span class="badge">Aprobada por Contabilidad</span>
      <h1 class="title">Rendición aprobada por Contabilidad</h1>
      <p>Estimado/a <strong>{{coordinatorName}}</strong>,</p>
      <p>La rendición de <strong>{{collaboratorName}}</strong> que usted aprobó ha sido <strong>aprobada por Contabilidad</strong>.</p>

      <div class="box">
        <div class="row"><strong>Título:</strong> {{reportTitle}}</div>
        <div class="row"><strong>Monto aprobado:</strong> S/ {{budgetFormatted}}</div>
      </div>

      <div class="btn-container">
        <a href="{{platformUrl}}" class="btn">Ir a la plataforma</a>
      </div>
{{> email-footer}}
