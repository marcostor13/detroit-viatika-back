{{> email-header}}
      <span class="badge badge-info">Pendiente de revisión</span>
      <h1 class="title">Gastos pendientes de revisión</h1>
      <p>Estimado/a <strong>{{coordinatorName}}</strong>,</p>
      <p>El colaborador <strong>{{collaboratorName}}</strong> tiene <strong>{{pendingCount}} comprobante(s) pendiente(s)</strong> de aprobación en sus viáticos activos.</p>

      <p class="label">Detalles rápidos:</p>
      <div class="box">
        <div class="row"><strong>Colaborador:</strong> {{collaboratorName}}</div>
        <div class="row"><strong>Lugar:</strong> {{place}}</div>
        <div class="row"><strong>Fechas:</strong> {{startDate}} al {{endDate}}</div>
        <div class="row"><strong>Comprobantes pendientes:</strong> {{pendingCount}}</div>
      </div>

      <div class="btn-container">
        <a href="{{platformUrl}}" class="btn">Ir a la plataforma</a>
      </div>
{{> email-footer}}
