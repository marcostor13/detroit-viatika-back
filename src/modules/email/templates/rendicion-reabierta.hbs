{{> email-header}}
      <span class="badge badge-info">Rendición reabierta</span>
      <h1 class="title">Rendición reabierta</h1>
      <p>Estimado/a <strong>{{recipientName}}</strong>,</p>
      <p>{{intro}}</p>

      <p class="label">Detalles rápidos:</p>
      <div class="box">
        <div class="row"><strong>Rendición:</strong> {{reportTitle}}</div>
        <div class="row"><strong>Motivo:</strong> {{reason}}</div>
      </div>

      <div class="btn-container">
        <a href="{{platformUrl}}" class="btn">Ir a la plataforma</a>
      </div>
{{> email-footer}}
