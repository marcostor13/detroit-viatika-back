{{> email-header}}

      <h1 class="heading">Recordatorio de rendición de viáticos</h1>
      <p>Estimado/a <strong>{{collaboratorName}}</strong>,</p>
      <div class="alert-box">
        <p style="margin: 0;">No hemos registrado documentos cargados en tus rendiciones activas durante {{#if isSemanal}}esta semana{{else}}este mes{{/if}}. Recuerda rendir tus gastos a tiempo.</p>
      </div>
      <p class="label">Viáticos activos:</p>
      <ul class="quick-list">
        <li>Lugar: {{place}}</li>
        <li>Periodo: {{startDate}} al {{endDate}}</li>
      </ul>
      <div class="btn-container">
        <a href="{{platformUrl}}" class="btn">Ir a mis rendiciones</a>
      </div>
{{> email-footer}}
