{{> email-header}}

      {{#if urgent}}
      <div class="urgent">{{urgentBanner}}</div>
      {{/if}}
      <h1 class="heading">{{emailTitle}}</h1>
      <p>Estimado/a <strong>{{recipientName}}</strong>,</p>
      <p>Una solicitud de viáticos ha sido aprobada en el <strong>primer nivel</strong> y está <strong>pendiente de tu aprobación final</strong> para ser procesada.</p>
      <div class="details">{{{detailBody}}}</div>
      <div class="btn-container">
        <a href="{{platformUrl}}" class="btn">Ir a la plataforma — Aprobar</a>
      </div>
{{> email-footer}}
