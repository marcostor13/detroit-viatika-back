{{> email-header}}
      <span class="badge badge-danger">Rechazada por Contabilidad</span>
      <h1 class="title">Rendición rechazada por Contabilidad</h1>
      <p>Estimado/a <strong>{{coordinatorName}}</strong>,</p>
      <p>La rendición de <strong>{{collaboratorName}}</strong> que usted aprobó fue <strong>rechazada por Contabilidad</strong> en la aprobación final.</p>

      <p class="label">Detalles rápidos:</p>
      <div class="box">
        <div class="row"><strong>Rendición:</strong> {{reportTitle}}</div>
        <div class="row"><strong>Colaborador:</strong> {{collaboratorName}}</div>
        <div class="row"><strong>Motivo:</strong> {{rejectionReason}}</div>
      </div>

      <div class="btn-container">
        <a href="{{platformUrl}}" class="btn">Ir a la plataforma</a>
      </div>
{{> email-footer}}
