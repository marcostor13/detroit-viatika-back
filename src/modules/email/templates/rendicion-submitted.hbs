{{> email-header}}
      <h1 class="title">Rendición enviada para revisión</h1>
      <p>Hola <strong>{{recipientName}}</strong>,</p>
      <p><strong>{{collaboratorName}}</strong> ha enviado una rendición de gastos para su revisión y aprobación.</p>

      <div class="box">
        <div class="row"><strong>Título:</strong> {{reportTitle}}</div>
        {{#if isDirecta}}
          {{#if hasDirectaDeposit}}<div class="row"><strong>Total depositado:</strong> S/ {{depositFormatted}}</div>{{/if}}
          <div class="row"><strong>Total gastado:</strong> S/ {{expenseTotalFormatted}}</div>
          {{#if hasDirectaDeposit}}<div class="row"><strong>Saldo disponible:</strong> S/ {{saldoFormatted}}</div>{{/if}}
        {{else}}
          <div class="row"><strong>Presupuesto:</strong> S/ {{budgetFormatted}}</div>
        {{/if}}
        <div class="row"><strong>Documentos adjuntos:</strong> {{expenseCount}}</div>
      </div>

      {{#if isDirecta}}
      <p class="box-title">Comprobantes ({{expenseCount}})</p>
      <table class="data">
        {{#each expenseItems}}
        <tr>
          <td>
            <span class="tag">{{this.categoryName}}</span>
            {{#if this.description}}<div class="tag-desc">{{this.description}}</div>{{/if}}
          </td>
          <td class="num">S/ {{this.totalFormatted}}</td>
        </tr>
        {{/each}}
        <tr class="total">
          <td>Total gastado</td>
          <td class="num">S/ {{expenseTotalFormatted}}</td>
        </tr>
        {{#if hasDirectaDeposit}}
        <tr class="total">
          <td>Saldo disponible</td>
          <td class="num">S/ {{saldoFormatted}}</td>
        </tr>
        {{/if}}
      </table>
      {{/if}}

      <p>Ingrese a la plataforma para revisar los comprobantes y aprobar o rechazar la rendición.</p>

      <div class="btn-container">
        <a href="{{platformUrl}}" class="btn">Revisar rendición</a>
      </div>
{{> email-footer}}
