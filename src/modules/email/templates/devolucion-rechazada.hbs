{{> email-header}}
      <span class="badge badge-danger">Comprobante rechazado</span>
      <h1 class="title">Comprobante de devolución rechazado</h1>
      <p>Estimado/a <strong>{{recipientName}}</strong>,</p>
      <p>El comprobante de devolución del anticipo N° <strong>{{advanceId}}</strong> ha sido <strong>rechazado</strong>.</p>
      {{#if rejectionReason}}
      <div class="box">
        <p class="box-title">Motivo del rechazo</p>
        <div class="row">{{rejectionReason}}</div>
      </div>
      {{/if}}
      <p>Por favor cargue un nuevo comprobante en la plataforma lo antes posible.</p>
{{> email-footer}}
