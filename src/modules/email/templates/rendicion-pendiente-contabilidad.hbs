{{> email-header}}
      <span class="badge badge-info">Pendiente de aprobación final</span>
      <h1 class="title">Rendición pendiente de aprobación final</h1>
      <p>Estimado/a <strong>{{recipientName}}</strong>,</p>
      <p>La rendición de <strong>{{collaboratorName}}</strong> fue aprobada por el coordinador y se encuentra <strong>pendiente de su aprobación final</strong>.</p>

      <div class="box">
        <div class="row"><strong>Título:</strong> {{reportTitle}}</div>
        <div class="row"><strong>Presupuesto:</strong> S/ {{budgetFormatted}}</div>
        <div class="row"><strong>Documentos adjuntos:</strong> {{expenseCount}}</div>
      </div>

      <div class="btn-container">
        <a href="{{platformUrl}}" class="btn">Ir a la plataforma</a>
      </div>
{{> email-footer}}
