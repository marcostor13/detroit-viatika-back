{{> email-header}}

      <h1 class="heading">Nueva solicitud de viáticos</h1>
      <p>Estimado/a <strong>{{coordinatorName}}</strong></p>
      <p>El colaborador <strong>{{collaboratorName}}</strong> ha enviado una nueva solicitud de viáticos. Revisar solicitud en la plataforma</p>
      <p class="label">Detalles rápidos:</p>
      <ul class="quick-list">
        <li>Lugar: {{place}}</li>
        <li>Fechas: {{startDate}} al {{endDate}}</li>
        <li>Monto Total: {{currencySymbol}} {{totalFormatted}}</li>
      </ul>
      <div class="btn-container">
        <a href="{{platformUrl}}" class="btn">Ir a la plataforma</a>
      </div>
{{> email-footer}}
