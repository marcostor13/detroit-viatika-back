{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "watchAssets": true,
    "assets": [
      { "include": "docs/asientos/*.xlsm", "outDir": "./dist" },
      { "include": "modules/email/templates/**/*.hbs", "outDir": "./dist" }
    ]
  }
}
